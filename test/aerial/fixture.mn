global shout = (s) => s:upper()

module class Animal {
  sound = 'hm'
  new(name) { self.name = name }
  static create() { return Animal.new('x') }
  speak() { return self.sound }
}

local class Dog : Animal {
  speak() { return 'woof' }
}

module function setup(o) {
  local function merge(a, b) { return b }
  module.opts = merge(module.opts, o)
}

